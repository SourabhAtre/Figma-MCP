{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Mrs+Saint+Delafield&display=swap');

  #HeroSplit-{{ section.id }} {
    --hero-split-padding-top: {{ section.settings.padding_top }}px;
    --hero-split-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #HeroSplit-{{ section.id }} .hero-split {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  #HeroSplit-{{ section.id }} .hero-split__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
  }

  #HeroSplit-{{ section.id }} .hero-split__media img,
  #HeroSplit-{{ section.id }} .hero-split__media .placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover; 
  }

  #HeroSplit-{{ section.id }} .hero-split__media-fade {
    display: none;
  }

  #HeroSplit-{{ section.id }} .hero-split__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.3rem;
    text-align: center;
    max-width: 62rem;
    margin: 0 auto;
    padding: var(--hero-split-padding-top) 3.2rem var(--hero-split-padding-bottom);
  }

  #HeroSplit-{{ section.id }} .hero-split__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #HeroSplit-{{ section.id }} .hero-split__heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    column-gap: 1.6rem;
    row-gap: 0.4rem;
  }

  #HeroSplit-{{ section.id }} .hero-split__heading-bold {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    color: rgb(var(--color-foreground));
    font-size: clamp(3.2rem, 6vw, 5.4rem);
    line-height: 1.05;
    word-break: break-word;
  }

  #HeroSplit-{{ section.id }} .hero-split__heading-accent {
    font-family: 'Mrs Saint Delafield', cursive;
    font-weight: 400;
    color: rgb(var(--color-foreground));
    font-size: clamp(4.4rem, 9vw, 8.6rem);
    line-height: 1;
  }

  #HeroSplit-{{ section.id }} .hero-split__text {
    max-width: 56rem;
    font-size: 1.6rem;
    line-height: 1.5;
  }

  #HeroSplit-{{ section.id }} .hero-split__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
  }

  #HeroSplit-{{ section.id }} .hero-split__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  #HeroSplit-{{ section.id }} .hero-split__rating svg {
    width: 7.2rem;
    height: auto;
    flex-shrink: 0;
  }

  #HeroSplit-{{ section.id }} .hero-split__rating p {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
  }

  #HeroSplit-{{ section.id }} .hero-split__button {
    min-width: 22rem;
  }

  @media screen and (min-width: 990px) {
    #HeroSplit-{{ section.id }} .hero-split {
      flex-direction: row;
      min-height: clamp(48rem, 55vw, 64rem);
    }

    #HeroSplit-{{ section.id }} .hero-split__media {
      position: absolute;
      inset: 0 0 0 auto;
      width: 62%;
      height: 100%;
      aspect-ratio: auto;
    }

    #HeroSplit-{{ section.id }} .hero-split__media-fade {
      display: block;
      position: absolute;
      inset: 0 auto 0 0;
      width: 30%;
      background: linear-gradient(to right, rgb(var(--color-background)) 0%, rgba(var(--color-background), 0) 100%);
    }

    #HeroSplit-{{ section.id }} .hero-split__content {
      width: 46%;
      margin: 0;
      padding-left: 8rem;
      padding-right: 4rem;
      justify-content: center;
    }
  }
{%- endstyle -%}

<div id="HeroSplit-{{ section.id }}" class="color-{{ section.settings.color_scheme }}">
  <div class="hero-split">
    <div class="hero-split__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            widths: '375, 550, 750, 1100, 1500, 2000',
            sizes: '(min-width: 990px) 62vw, 100vw'
        }}
      {%- else -%}
        {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      <span class="hero-split__media-fade" aria-hidden="true"></span>
    </div>
    <div class="hero-split__content">
      <div class="hero-split__heading">
        <div class="hero-split__heading-row">
          {%- if section.settings.heading_line_1 != blank -%}
            <span class="hero-split__heading-bold">{{ section.settings.heading_line_1 | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_accent != blank -%}
            <span class="hero-split__heading-accent">{{ section.settings.heading_accent | escape }}</span>
          {%- endif -%}
        </div>
        {%- if section.settings.heading_line_2 != blank -%}
          <span class="hero-split__heading-bold">{{ section.settings.heading_line_2 | escape }}</span>
        {%- endif -%}
      </div>
      {%- if section.settings.description != blank -%}
        <div class="hero-split__text rte">{{ section.settings.description }}</div>
      {%- endif -%}
      <div class="hero-split__cta">
        {%- if section.settings.show_rating -%}
          <div class="hero-split__rating">
            {{- 'icon-star-rating-5.svg' | inline_asset_content -}}
            {%- if section.settings.rating_text != blank -%}
              <p>{{ section.settings.rating_text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link == blank %}
              role="link"
              aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button button--primary hero-split__button"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero split image",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading, line 1",
      "default": "Radiate"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "info": "Rendered in a decorative script font.",
      "default": "confidence"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading, line 2",
      "default": "in every strand"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Let your hair radiate confidence with our premium formulations, designed to nourish and strengthen every strand from root to tip.</p>"
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Rated 4.9 out of 5 by over 5,126+ customers"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Hero split image"
    }
  ]
}
{% endschema %}
